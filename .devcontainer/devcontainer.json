import streamlit as st
import yfinance as yf
import pandas as pd
import requests
import io
from datetime import datetime, timedelta

st.set_page_config(page_title="Swing Screener Fix", layout="wide")
st.title("🛡️ Super-Stable Stock Filter")

# 1. Ticker List (Nifty 100 for speed and stability)
@st.cache_data
def get_reliable_tickers():
    return [
        "RELIANCE.NS", "TCS.NS", "HDFCBANK.NS", "ICICIBANK.NS", "INFY.NS", "BHARTIARTL.NS",
        "SBI.NS", "ITC.NS", "HINDUNILVR.NS", "LT.NS", "BAJFINANCE.NS", "HCLTECH.NS",
        "MARUTI.NS", "SUNPHARMA.NS", "ADANIENT.NS", "TITAN.NS", "ONGC.NS", "TATAMOTORS.NS",
        "NTPC.NS", "AXISBANK.NS", "ADANIPORTS.NS", "ASIANPAINT.NS", "COALINDIA.NS",
        "BAJAJFINSV.NS", "BPCL.NS", "TATASTEEL.NS", "WIPRO.NS", "M&M.NS", "TRENT.NS", "ZOMATO.NS"
    ]

# 2. Strategy Logic
def check_strategy(df, rsi_limit, vol_mult):
    if len(df) < 200: return False, None
    
    # EMAs
    df['EMA50'] = df['Close'].ewm(span=50, adjust=False).mean()
    df['EMA200'] = df['Close'].ewm(span=200, adjust=False).mean()
    
    # RSI
    delta = df['Close'].diff()
    gain = delta.where(delta > 0, 0).rolling(14).mean()
    loss = -delta.where(delta < 0, 0).rolling(14).mean()
    df['RSI'] = 100 - (100 / (1 + (gain / loss)))
    
    # MACD
    ema12 = df['Close'].ewm(span=12, adjust=False).mean()
    ema26 = df['Close'].ewm(span=26, adjust=False).mean()
    df['MACD'] = ema12 - ema26
    df['Sig'] = df['MACD'].ewm(span=9, adjust=False).mean()
    
    # Vol & ATR
    df['VolAvg'] = df['Volume'].rolling(20).mean()
    df['ATR'] = (df['High'] - df['Low']).rolling(14).mean()
    
    l = df.iloc[-1]
    
    # Filter Checks
    c1 = l['Close'] > l['EMA50'] and l['Close'] > l['EMA200']
    c2 = l['RSI'] > rsi_limit
    c3 = l['MACD'] > l['Sig'] and l['MACD'] > 0
    c4 = l['Volume'] > (l['VolAvg'] * vol_mult)
    
    if c1 and c2 and c3 and c4:
        return True, {
            "Price": round(float(l['Close']), 2),
            "RSI": round(float(l['RSI']), 1),
            "Vol": f"{round(float(l['Volume']/l['VolAvg']),1)}x",
            "SL": round(float(l['Close'] - 1.5*l['ATR']), 2),
            "Target": round(float(l['Close'] + 3*l['ATR']), 2)
        }
    return False, None

# Sidebar
st.sidebar.header("Settings")
target_date = st.sidebar.date_input("Date", datetime.now() - timedelta(days=1))
rsi_val = st.sidebar.slider("RSI Min", 40, 70, 50)
vol_val = st.sidebar.slider("Vol Mult", 1.0, 2.0, 1.0)

if st.sidebar.button("Run Scanner"):
    tickers = get_reliable_tickers()
    results = []
    
    st.info(f"Scanning {len(tickers)} stocks for {target_date}...")
    
    for ticker in tickers:
        try:
            # Download with 2y period to ensure indicators work
            df = yf.download(ticker, end=target_date + timedelta(days=1), period="2y", progress=False)
            
            # Multi-index fix
            if isinstance(df.columns, pd.MultiIndex):
                df.columns = df.columns.get_level_values(0)
            
            if df.empty:
                st.warning(f"Data not found for {ticker}")
                continue
                
            is_match, data = check_strategy(df, rsi_val, vol_val)
            if is_match:
                data['Symbol'] = ticker.replace(".NS","")
                results.append(data)
                
        except Exception as e:
            st.error(f"Error on {ticker}: {e}")
            
    if results:
        st.success(f"Matches Found!")
        st.table(pd.DataFrame(results))
    else:
        st.warning("No stocks matched the criteria. Please try a different date or lower RSI.")
